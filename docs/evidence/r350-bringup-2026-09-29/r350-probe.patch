@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * R300 fragment ISA translation foundation. Register encodings reference
+ * Linux drivers/gpu/drm/radeon/r300_reg.h. No R200 interpretation is used.
+ */
+#ifndef R300_FP_STANDALONE
+#include "qemu/osdep.h"
+#endif
+#include <stdio.h>
+#include <string.h>
+#include "ppc_mac_gpu_r300_fp.h"
+
+static bool operand(char *out, size_t cap, const R300FPProgram *p,
+                    unsigned field, bool alpha)
+{
+    unsigned sel = field & 31, source = 0;
+    uint32_t addresses = p->rgb_addr;
+    const char *swizzle = NULL;
+    char base[64];
+
+    if ((!alpha && (sel == 20 || sel == 21)) ||
+        (alpha && (sel == 16 || sel == 17))) {
+        snprintf(base, sizeof(base), "%s(%s)", alpha ? "float" : "float3",
+                 (sel == 21 || sel == 17) ? "1.0" : "0.0");
+    } else {
+        if (alpha) {
+            if (sel <= 8) {
+                source = sel / 3;
+                swizzle = (const char *[]) {"x", "y", "z"}[sel % 3];
+            } else if (sel <= 11) {
+                source = sel - 9;
+                addresses = p->alpha_addr;
+                swizzle = "w";
+            }
+        } else if (sel <= 11) {
+            source = sel / 4;
+            swizzle = (const char *[]) {"xyz", "xxx", "yyy", "zzz"}[sel % 4];
+        } else if (sel <= 14) {
+            source = sel - 12;
+            addresses = p->alpha_addr;
+            swizzle = "www";
+        } else if (sel >= 23 && sel <= 28) {
+            source = (sel - 23) % 3;
+            swizzle = sel < 26 ? "yzx" : "zxy";
+        }
+        /* Half, LRP and mixed color/alpha WZY need separate validation. */
+        if (!swizzle || !(addresses & (1u << (source * 6 + 5)))) {
+            return false;
+        }
+        unsigned index = (addresses >> (source * 6)) & 31;
+        snprintf(base, sizeof(base), "c[%u].%s", index, swizzle);
+    }
+    snprintf(out, cap, "%s%s(%s)", (field & 32) ? "-" : "",
+             (field & 64) ? "abs" : "", base);
+    return true;
+}
+
+bool r300_fp_compile_msl(const R300FPProgram *p, char *out, size_t capacity,
+                         char *error, size_t error_capacity)
+{
+    const char *reason = NULL;
+    char rgb[3][96], alpha[3][96];
+    out[0] = error[0] = 0;
+    if (p->control[0] != 0 || p->control[1] > 31 || p->control[2] != 0 ||
+        p->node[3] != (1u << 22)) {
+        reason = "requires one texture-free ALU node with one instruction";
+    } else if ((p->rgb_addr & ~0x3ffffu) != (7u << 26) ||
+               (p->alpha_addr & ~0x3ffffu) != (1u << 24)) {
+        reason = "requires full color output 0 without temporary/depth writes";
+    } else if ((p->rgb_inst | p->alpha_inst) & ~0x401fffffu) {
+        reason = "unsupported ALU operation or modifier (only MAD and SAT)";
+    }
+    if (!reason) {
+        for (unsigned i = 0; i < 3; i++) {
+            if (!operand(rgb[i], sizeof(rgb[i]), p,
+                         (p->rgb_inst >> (7 * i)) & 127, false) ||
+                !operand(alpha[i], sizeof(alpha[i]), p,
+                         (p->alpha_inst >> (7 * i)) & 127, true)) {
+                reason = "unsupported operand or temporary input";
+                break;
+            }
+        }
+    }
+    if (reason) {
+        snprintf(error, error_capacity, "%s", reason);
+        return false;
+    }
+    int n = snprintf(out, capacity,
+        "#include <metal_stdlib>\nusing namespace metal;\n"
+        "fragment float4 r300_fragment(constant float4 *c [[buffer(0)]]) {\n"
+        " float3 rgb = (%s) * (%s) + (%s);\n"
+        " float a = (%s) * (%s) + (%s);\n"
+        " %s\n %s\n return float4(rgb, a);\n}\n",
+        rgb[0], rgb[1], rgb[2], alpha[0], alpha[1], alpha[2],
+        (p->rgb_inst & (1u << 30)) ? "rgb = clamp(rgb, 0.0f, 1.0f);" : "",
+        (p->alpha_inst & (1u << 30)) ? "a = clamp(a, 0.0f, 1.0f);" : "");
+    if (n < 0 || (size_t)n >= capacity) {
+        out[0] = 0;
+        snprintf(error, error_capacity, "MSL output buffer too small");
+        return false;
+    }
+    return true;
+}
