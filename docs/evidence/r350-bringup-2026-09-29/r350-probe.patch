+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef PPC_MAC_GPU_R300_FP_H
+#define PPC_MAC_GPU_R300_FP_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* First R300 translation gate: one ALU node, one MAD, constant operands,
+ * full output 0. No textures, temporary inputs/outputs, depth or vertex ISA.
+ * Constants supplied to the generated Metal function are already float32;
+ * decoding the guest's float24 constant bank is a separate responsibility.
+ */
+typedef struct R300FPProgram {
+    uint32_t control[3];      /* 0x4600, 0x4604, 0x4608 */
+    uint32_t node[4];         /* 0x4610..0x461c; last active node is node[3] */
+    uint32_t rgb_addr;        /* 0x46c0 */
+    uint32_t alpha_addr;      /* 0x47c0 */
+    uint32_t rgb_inst;        /* 0x48c0 */
+    uint32_t alpha_inst;      /* 0x49c0 */
+} R300FPProgram;
+
+/* Produces a complete MSL fragment function named r300_fragment.
+ * On failure, clears the output and supplies an unsupported-state reason.
+ * Buffer pointers must be non-NULL and capacities nonzero.
+ */
+bool r300_fp_compile_msl(const R300FPProgram *p, char *out, size_t capacity,
+                         char *error, size_t error_capacity);
+#endif
