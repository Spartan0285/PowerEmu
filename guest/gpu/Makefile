# PowerEmu paravirtual GPU kext, for Mac OS X 10.4 on PowerPC.
#
# Built on a PowerPC Mac with Xcode 2.5 (gcc 4.0, 10.4u SDK):
#   scripts/build.sh [host]    (from a modern Mac; default host pbg4)
#
# Not buildable with the powerpc-apple-darwin9 cross toolchain in the
# ppcbuild VM: gcc 6.5 cannot compile Apple's 10.4 kernel headers, and a
# 10.4 kext has to carry Apple gcc 4.0's C++ ABI or the kernel linker will
# not resolve its vtables.  Userspace PPC code has no such constraint --
# that is why the GL plugin cross-builds and this does not.

NAME    = PowerEmuGPU
BUNDLE  = com.spartan0285.poweremu.gpu
VERSION = 1.0.0

SDK     = /Developer/SDKs/MacOSX10.4u.sdk
CC      = gcc-4.0
CXX     = g++-4.0

KFRAME  = $(SDK)/System/Library/Frameworks/Kernel.framework
KDEFS   = -DKERNEL -DKERNEL_PRIVATE -DDRIVER_PRIVATE -DAPPLE -DNeXT
KINC    = -nostdinc -I$(KFRAME)/Headers -I$(KFRAME)/PrivateHeaders -Isrc

# -mlong-branch keeps a call from the kext into the kernel from overflowing
# a 24-bit branch displacement.  Apple's own kext template sets it for ppc,
# but gcc 4.0 deprecated it in favour of -mlongcall: if the compiler rejects
# it, swap it or drop it rather than fighting it.
PPCFLAGS = -mlong-branch

# -static (no dyld), -msoft-float (no FP registers in the kernel) and
# -nostdinc are not optional.  -fapple-kext selects the C++ ABI the 10.4
# kernel's linker expects; without it the kext builds and then fails to load
# with unresolved vtable symbols.
KFLAGS   = -arch ppc -isysroot $(SDK) -static -msoft-float -fno-common \
           -fno-builtin $(PPCFLAGS) -Os -Wall -Wno-unused-parameter \
           $(KDEFS) $(KINC)
CXXFLAGS = $(KFLAGS) -fapple-kext -fno-exceptions -fno-rtti -fcheck-new \
           -finline -fno-keep-inline-functions

KEXT   = build/$(NAME).kext
EXEC   = $(KEXT)/Contents/MacOS/$(NAME)
OBJS   = build/PEGpuAccelerator.o build/PEGpuUserClient.o build/kmod_info.o

all: $(EXEC)

# libkmodc++ supplies the _start/_stop that run this kext's static
# constructors -- the OSDefineMetaClassAndStructors registrations -- before
# IOKit is allowed to match anything.  libkmod alone would link and then
# match nothing at all.
$(EXEC): $(OBJS) Resources/Info.plist
	mkdir -p $(KEXT)/Contents/MacOS
	$(CXX) -arch ppc -isysroot $(SDK) -static -nostdlib -r -o $@ $(OBJS) \
	    -lkmodc++ -lcc_kext -lkmod
	cp Resources/Info.plist $(KEXT)/Contents/Info.plist
	touch $(KEXT)

HDRS = src/PEGpuShared.h src/PEGpuAccelerator.h src/PEGpuUserClient.h

build/%.o: src/%.cpp $(HDRS)
	mkdir -p build
	$(CXX) $(CXXFLAGS) -c $< -o $@

build/kmod_info.o: build/kmod_info.c
	$(CC) $(KFLAGS) -c $< -o $@

# The kernel finds a kext's name, version and entry points through a
# kmod_info the bundle has to carry itself.  Generated rather than checked
# in so it cannot disagree with BUNDLE and VERSION above; _realmain and
# _antimain stay null because an IOKit kext does its work from its
# IOService, not from a module entry point.
build/kmod_info.c:
	mkdir -p build
	printf '%s\n' \
	    '/* Generated by the Makefile.  Do not edit. */' \
	    '#include <mach/mach_types.h>' \
	    '#include <mach/kmod.h>' \
	    'extern kern_return_t _start(kmod_info_t *ki, void *data);' \
	    'extern kern_return_t _stop(kmod_info_t *ki, void *data);' \
	    'KMOD_EXPLICIT_DECL($(BUNDLE), "$(VERSION)", _start, _stop)' \
	    '__private_extern__ kmod_start_func_t *_realmain = 0;' \
	    '__private_extern__ kmod_stop_func_t *_antimain = 0;' \
	    '__private_extern__ int _kext_apple_cc = __APPLE_CC__;' \
	    > $@

# Ownership is the guest's problem, not the build machine's: ditto brings
# the bundle back owned by whoever ran the build, and kextload refuses
# anything not owned by root:wheel.  See the README.
clean:
	rm -rf build

.PHONY: all clean
