<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	    The emulator translates PowerPC into arm64 while it runs and writes
	    the result into memory it then executes: tcg/region.c asks for
	    MAP_JIT.  Under the hardened runtime, which notarising requires,
	    that is refused without this and the virtual Mac dies the instant it
	    starts.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!--
	    PowerMusic's Audio Relay reads this Mac's own sound with a CoreAudio
	    process tap, so that the music Apple will only decrypt here can be
	    played by an old Mac in another room.  Under the hardened runtime,
	    which notarising requires, a process is refused the tap without
	    this whatever the owner has agreed to.  The tap exists only while an
	    old Mac is connected.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
