<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	    The emulator translates PowerPC into arm64 while it runs and writes
	    the result into memory it then executes: tcg/region.c asks for
	    MAP_JIT.  Under the hardened runtime, which notarising requires,
	    that is refused without this and the virtual Mac dies the instant it
	    starts.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!--
	    The Audio Relay listens to what this Mac is playing with a CoreAudio
	    process tap, so the music can be sent to an old Mac that cannot
	    decode it itself. A tap counts as audio input, and under the
	    hardened runtime it is refused without this whatever the reader has
	    allowed in Privacy & Security.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
